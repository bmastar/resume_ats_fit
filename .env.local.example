# Genere par la page Parametres — stocke en clair (non chiffre).
# Ne committe jamais ce fichier (.env.local est dans .gitignore).

# Provider actif : google | ollama | openai
PROVIDER=google

# --- Fenetre de generation & contexte ---
MAX_TOKENS=16 384
CONTEXT_WINDOW=16 384

# --- Google Gemini ---
GEMINI_API_KEY={google_api_key}
GEMINI_MODEL=gemini-3.5-flash

# --- Ollama compatible (endpoint natif) ---
OLLAMA_API_URL=https://ollama.com
OLLAMA_API_KEY={ollama_api_key}
OLLAMA_MODEL=gemma4:31b

# --- OpenAI Compatible (via SDK openai) ---
OPENAI_API_URL=https://api.openai.com/v1
OPENAI_API_KEY={openai_api_key}
OPENAI_MODEL=gpt-4o-mini
